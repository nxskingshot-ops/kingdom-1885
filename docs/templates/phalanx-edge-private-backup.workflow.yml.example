# PROPOSAL ONLY: not under .github/workflows, intentionally gated against execution.
# Requires owner approval, review, private B2 destination and Supabase permission validation.
name: PHALANX Edge encrypted private backup — REVIEW ONLY
on:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  backup:
    runs-on: ubuntu-24.04
    timeout-minutes: 25
    env:
      SUPABASE_ACCESS_TOKEN: ${{ secrets.SUPABASE_ACCESS_TOKEN }}
      PROJECT_REF: hcjrdofkdkasznywvcxo
      AWS_ACCESS_KEY_ID: ${{ secrets.B2_KEY_ID }}
      AWS_SECRET_ACCESS_KEY: ${{ secrets.B2_APPLICATION_KEY }}
      BACKUP_PASSPHRASE: ${{ secrets.PHALANX_BACKUP_ENCRYPTION_KEY }}
      B2_ENDPOINT: https://s3.eu-central-003.backblazeb2.com
      B2_BUCKET: nexus-phalanx-backup
    steps:
      - name: Preflight without exposing secrets
        shell: bash
        run: |
          set -euo pipefail
          for name in SUPABASE_ACCESS_TOKEN AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY BACKUP_PASSPHRASE; do
            if [ -z "${!name:-}" ]; then echo "::error::Missing $name"; exit 1; fi
          done
      - name: Install CLI dependencies
        run: |
          npm install --global supabase
          sudo apt-get update -qq
          sudo apt-get install -y -qq awscli openssl
      - name: Download function sources into ephemeral runner
        shell: bash
        run: |
          set -euo pipefail
          umask 077
          mkdir -p "$RUNNER_TEMP/phalanx-edge"
          cd "$RUNNER_TEMP/phalanx-edge"
          supabase init
          supabase link --project-ref "$PROJECT_REF"
          supabase functions download
          test -d supabase/functions
          test "$(find supabase/functions -mindepth 1 -maxdepth 1 -type d | wc -l)" -gt 0
      - name: Security gate — encryption and restore test not yet approved
        shell: bash
        run: |
          echo "::error::Review required: implement authenticated encryption, upload, checksum and non-production restore validation."
          exit 1
# No git add/commit/push; no Actions artifact upload; never echo source or tokens.
