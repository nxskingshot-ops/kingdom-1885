+// Provider capture stamps are UTC epoch seconds or ISO; saved captures are ISO.
+export function captureIso(value: unknown): string | null {
+  const numeric = typeof value === "number" || (typeof value === "string" && /^\d+(?:\.\d+)?$/.test(value));
+  const date = numeric
+    ? new Date(Number(value) * (Number(value) >= 1e12 ? 1 : 1000))
+    : typeof value === "string" && /^\d{4}-\d{2}-\d{2}T/.test(value) && /(?:Z|[+-]\d{2}:\d{2})$/.test(value)
+      ? new Date(value)
+      : null;
+  if (!date || !Number.isFinite(date.getTime()) || date.getTime() < 0) return null;
+  const fraction = typeof value === "string" ? value.match(/T\d{2}:\d{2}:\d{2}\.(\d+)/)?.[1] : undefined;
+  return date.toISOString().replace(/Z$/, (fraction ?? "").slice(3, 9).padEnd(6, "0") + "Z");
+}
+
+export function preferStoredCapture(provider: unknown, stored: unknown): boolean {
+  const saved = captureIso(stored);
+  return saved !== null && saved > (captureIso(provider) ?? "");
+}
